# Ollama (local LLM server — install from https://ollama.com)
OLLAMA_HOST=http://localhost:11434
# Pick a model that fits in your GPU's VRAM for real-time replies — a 7B+ model
# that spills onto CPU can take 30s-2min per reply. llama3.2:3b fits in ~3GB VRAM
# and replies in under 2s once warm. Avoid "thinking"/reasoning model variants
# (e.g. some gemma releases) — they generate a long hidden reasoning trace before
# every reply, which is deadly for conversational latency.
OLLAMA_MODEL=llama3.2:3b
# How long Ollama keeps the model loaded after the last request, so a whole
# practice session doesn't reload the model on every turn.
OLLAMA_KEEP_ALIVE=30m

# faster-whisper (speech-to-text)
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=small
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (fastest on CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# Piper (text-to-speech)
# Voice name must match a downloaded model in backend/voices/, e.g.:
#   python -m piper.download_voices --download-dir backend/voices fr_FR-siwis-medium
PIPER_VOICE_NAME=fr_FR-siwis-medium
PIPER_USE_CUDA=false

# Local data storage (session history, gitignored, never leaves your machine)
DATA_DIR=./data
