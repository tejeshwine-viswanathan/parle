# Ollama (local LLM server — install from https://ollama.com)
# Ignored under `docker compose up`, which always reaches the host's Ollama via
# host.docker.internal — the model settings below still apply there.
OLLAMA_HOST=http://localhost:11434
# Pick a model that fits in your GPU's VRAM for real-time replies — a 7B+ model
# that spills onto CPU can take 30s-2min per reply. llama3.2:3b fits in ~3GB VRAM
# and replies in under 2s once warm. Avoid "thinking"/reasoning model variants
# (e.g. some gemma releases) — they generate a long hidden reasoning trace before
# every reply, which is deadly for conversational latency.
OLLAMA_MODEL=llama3.2:3b
# How long Ollama keeps the model loaded after the last request, so a whole
# practice session doesn't reload the model on every turn.
OLLAMA_KEEP_ALIVE=30m
# Context window (tokens) for every chat call. Ollama's default of 2048 silently
# drops the system prompt once a conversation grows past ~15 turns.
OLLAMA_NUM_CTX=8192
# Optional: a separate (larger) model just for topic-practice grammar correction
# (backend/grammar.py), which is a harder task than conversation/translation —
# small models are unreliable at it. Defaults to OLLAMA_MODEL if unset. Only
# worth setting if you have a bigger model already pulled, e.g.:
# GRAMMAR_MODEL=mistral:7b
# A larger model (e.g. gemma4:26b) tests more reliable still, but expect ~2min
# to load cold and ~15s per sentence once warm — only worth it if you don't
# mind the wait in exchange for fewer wrong "corrections".
# Translation (backend/translate.py) does NOT use Ollama at all — it runs on a
# dedicated offline MT model (Argos Translate), installed separately, see README.

# faster-whisper (speech-to-text)
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=small
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (fastest on CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# Piper (text-to-speech)
# Voice name must match a downloaded model in backend/voices/, e.g.:
#   python -m piper.download_voices --download-dir backend/voices fr_FR-siwis-medium
PIPER_VOICE_NAME=fr_FR-siwis-medium
PIPER_USE_CUDA=false

# Local data storage (session history, gitignored, never leaves your machine)
DATA_DIR=./data
